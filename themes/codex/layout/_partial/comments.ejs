<% if (page.comments && theme.giscus && theme.giscus.enable) { %>
  <section class="comments" aria-label="<%= __('post.comments') %>">
    <div data-giscus
         data-repo="<%= theme.giscus.repo %>"
         data-repo-id="<%= theme.giscus.repo_id %>"
         data-category="<%= theme.giscus.category %>"
         data-category-id="<%= theme.giscus.category_id %>"
         data-lang="<%= theme.giscus.lang || 'zh-CN' %>"></div>
  </section>
<% } %>
