<dialog class="search-dialog" data-search-dialog
        data-index="<%- url_for(theme.search.path || 'search.json') %>"
        data-empty="<%= __('search.empty') %>"
        data-error="<%= __('search.error') %>"
        aria-label="<%= __('search.open') %>">
  <form method="dialog" class="search-form">
    <input type="search" placeholder="<%= __('search.placeholder') %>" aria-label="<%= __('search.placeholder') %>" autocomplete="off" spellcheck="false">
    <button type="submit" class="search-close" aria-label="Esc">Esc</button>
  </form>
  <ul class="search-results" data-search-results></ul>
</dialog>
